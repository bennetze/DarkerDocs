{
  "manifest_version": 3,
  "name": "DarkerDocs",
  "version": "0.3.1",
  "description": "Four themes for Google Workspace. Adapt text and surfaces while keeping images, saved colors and exports original.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": {
    "default_title": "DarkerDocs",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*"
      ],
      "exclude_matches": [
        "https://docs.google.com/document/*/print*",
        "https://docs.google.com/spreadsheets/*/print*"
      ],
      "js": ["content/renderer.bundle.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/presentation/*",
        "https://docs.google.com/forms/*"
      ],
      "exclude_matches": [
        "https://docs.google.com/presentation/*/present*",
        "https://docs.google.com/presentation/*/embed*",
        "https://docs.google.com/document/*/print*",
        "https://docs.google.com/spreadsheets/*/print*"
      ],
      "css": ["shared/themes.css", "content/content.css"],
      "js": ["shared/core.js", "content/content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
